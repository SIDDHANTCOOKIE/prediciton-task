# Postgres connection string (e.g. from Neon or Render Postgres)
DATABASE_URL=postgres://user:password@host/db

# Secret token used to secure the /ingest route (e.g. from cron-job.org or UptimeRobot)
INGEST_TOKEN=your-secret-token

# Enable Kalshi ingestion
KALSHI_ENABLED=true

# Kalshi's real leaderboard list endpoint, confirmed and working:
#   https://api.elections.kalshi.com/v1/social/leaderboard?metric_name=X&limit=20&time_period=Y
# Confirmed metric_name values: projected_pnl (closest to "profit"), volume, num_markets_traded.
# Confirmed time_period value: weekly (an all-time equivalent may exist but hasn't been found —
# see server/README.md for how to check). KALSHI_LIST_URL overrides both if you'd rather paste
# a full confirmed URL directly.
KALSHI_METRIC_NAME=projected_pnl
KALSHI_TIME_PERIOD=weekly
# KALSHI_LIST_URL=https://api.elections.kalshi.com/v1/social/leaderboard?metric_name=projected_pnl&limit=20&time_period=weekly

# Allowed CORS origin (e.g. https://your-frontend.vercel.app or *)
FRONTEND_ORIGIN=*

# Number of top traders to fetch from Polymarket
LEADERBOARD_LIMIT=100
