{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "..",
    "outDir": "dist"
  },
  "include": ["src/**/*", "../lib/**/*"],
  "exclude": ["node_modules", "dist"]
}
